// Deathmatch Configuration

echo "Loading Deathmatch settings"

// Game mode
game_mode 1
game_type 1

// Match settings
mp_maxrounds 1
mp_timelimit 10
mp_overtime_enable 0

// Round settings
mp_roundtime 10
mp_freezetime 0
mp_buytime 9999
mp_buy_anywhere 1
mp_buy_during_immunity 0

// Money
mp_startmoney 16000
mp_maxmoney 16000
mp_playercashawards 0
mp_teamcashawards 0

// Team settings
mp_teammates_are_enemies 0
mp_autoteambalance 1
mp_limitteams 0

// Damage & Armor
mp_damage_headshot_only 0
mp_friendlyfire 0
mp_tkpunish 0

// Death & Respawn
mp_respawn_on_death_ct 1
mp_respawn_on_death_t 1
mp_respawn_immunitytime 1

// DM specific
mp_dm_bonus_length_max 30
mp_dm_bonus_length_min 30
mp_dm_bonus_respawn_time 0
mp_dm_time_between_bonus_max 40
mp_dm_time_between_bonus_min 40

// Free armor
mp_free_armor 2  // Full armor + helmet

// Spectator
sv_alltalk 1
sv_deadtalk 1

echo "Deathmatch mode loaded"
