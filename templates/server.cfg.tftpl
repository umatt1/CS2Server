// Base CS2 Server Configuration
// Generated by Terraform

// Server Identity
hostname "${server_name}"
sv_password "${server_password}"
sv_lan 0

// RCON
rcon_password "${rcon_password}"

// Server Limits
sv_maxplayers ${max_players}
sv_visiblemaxplayers ${max_players}

// Networking
sv_hibernate_when_empty 0
sv_region 3  // US East
sv_lan 0
sv_steamgroup_exclusive 0

// Game Settings
mp_teamname_1 "Counter-Terrorists"
mp_teamname_2 "Terrorists"
mp_autokick 0
mp_autoteambalance 1
mp_limitteams 1

// Performance
sv_mincmdrate 64
sv_minupdaterate 64
sv_maxcmdrate ${tickrate}
sv_maxupdaterate ${tickrate}
sv_minrate 196608
sv_maxrate 0

// Logging
log on
sv_logbans 1
sv_logecho 1
sv_logfile 1
sv_log_onefile 0

// Execute game mode config
exec ${game_mode_config}
