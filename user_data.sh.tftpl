#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y curl ca-certificates gnupg

# Install Docker
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
  tee /etc/apt/sources.list.d/docker.list > /dev/null

apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io

systemctl enable docker
systemctl start docker

# Mount persistent EBS volume for CS2 game files
# This volume persists across instance recreations to avoid re-downloading CS2
config_dir="/opt/cs2-server"

if ! grep -qs "$config_dir" /proc/mounts; then
  echo "Setting up persistent CS2 data volume..."
  
  # Wait for EBS volume device to be available (AWS maps /dev/sdf to /dev/nvme1n1)
  device="/dev/nvme1n1"
  timeout=30
  while [ ! -e "$device" ] && [ $timeout -gt 0 ]; do
    echo "Waiting for device $device..."
    sleep 2
    timeout=$((timeout - 2))
  done
  
  if [ ! -e "$device" ]; then
    echo "ERROR: Device $device not found after timeout"
    exit 1
  fi
  
  # Format the volume if it's new (no filesystem detected)
  if ! blkid "$device" | grep -q TYPE; then
    echo "Formatting new CS2 data volume..."
    mkfs.ext4 -L cs2-data "$device"
  else
    echo "Existing filesystem detected on CS2 data volume"
  fi
  
  # Create mount point and mount the volume
  mkdir -p "$config_dir"
  mount "$device" "$config_dir"
  
  # Add to fstab for persistence across reboots (using LABEL for reliability)
  if ! grep -qs "$config_dir" /etc/fstab; then
    echo "LABEL=cs2-data $config_dir ext4 defaults,nofail 0 2" >> /etc/fstab
  fi
  
  # Set ownership to steam user (uid 1000) for Docker container compatibility
  chown -R 1000:1000 "$config_dir"
  chmod 755 "$config_dir"
  
  echo "CS2 data volume mounted at $config_dir"
else
  echo "CS2 data volume already mounted at $config_dir"
  # Ensure permissions are correct even if volume already mounted
  chown -R 1000:1000 "$config_dir"
fi

# Create config directory structure
mkdir -p "$config_dir/game/csgo/cfg"

# Write configuration files
cat > "$config_dir/game/csgo/cfg/server.cfg" <<'SERVERCFG'
${server_cfg}
SERVERCFG

cat > "$config_dir/game/csgo/cfg/autoexec.cfg" <<'AUTOEXECCFG'
${autoexec_cfg}
AUTOEXECCFG

cat > "$config_dir/game/csgo/cfg/gamemode_competitive.cfg" <<'COMPCFG'
${gamemode_competitive_cfg}
COMPCFG

cat > "$config_dir/game/csgo/cfg/gamemode_casual.cfg" <<'CASUALCFG'
${gamemode_casual_cfg}
CASUALCFG

cat > "$config_dir/game/csgo/cfg/gamemode_deathmatch.cfg" <<'DMCFG'
${gamemode_deathmatch_cfg}
DMCFG

cat > "$config_dir/game/csgo/cfg/practice.cfg" <<'PRACTICECFG'
${practice_cfg}
PRACTICECFG

# Apply custom CVARs if any
%{ if length(server_cvars) > 0 ~}
cat >> "$config_dir/game/csgo/cfg/server.cfg" <<'CUSTOMCVARS'

// Custom CVARs from Terraform
%{ for key, value in server_cvars ~}
${key} "${value}"
%{ endfor ~}
CUSTOMCVARS
%{ endif ~}

# Build Docker run command with proper environment variables
workshop_args=""
%{ if workshop_collection_id != "" && workshop_start_map_id != "" ~}
workshop_args="-e CS2_WORKSHOP_COLLECTION_ID=${workshop_collection_id} -e CS2_WORKSHOP_START_MAP_ID=${workshop_start_map_id}"
%{ endif ~}

cat > /etc/systemd/system/cs2.service <<EOF
[Unit]
Description=CS2 Dedicated Server (Docker)
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker stop cs2-server
ExecStartPre=-/usr/bin/docker rm cs2-server
ExecStart=/usr/bin/docker run --rm --name cs2-server \\
  --network=host \\
  -v $config_dir:/home/steam/cs2-dedicated \\
  -e SRCDS_TOKEN=${gslt} \\
  -e CS2_SERVERNAME="${server_name}" \\
  -e CS2_PORT=27015 \\
  -e CS2_MAXPLAYERS=${max_players} \\
  -e CS2_STARTMAP=${default_map} \\
  -e CS2_TICKRATE=${tickrate} \\
  -e CS2_GAMEALIAS=${game_mode} \\
  $workshop_args \\
  joedwards32/cs2:latest
ExecStop=/usr/bin/docker stop cs2-server
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload

# Pull Docker image
echo "Pulling CS2 Docker image..."
docker pull joedwards32/cs2:latest

# Install CounterStrikeSharp and plugins
%{ if plugin_mode != "vanilla" ~}
echo "Installing CounterStrikeSharp framework..."
mkdir -p /tmp/css-install
cd /tmp/css-install

# Download latest CounterStrikeSharp
CSS_VERSION=$(curl -s https://api.github.com/repos/roflmuffin/CounterStrikeSharp/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/')
wget -q "https://github.com/roflmuffin/CounterStrikeSharp/releases/download/v$${CSS_VERSION}/counterstrikesharp-with-runtime-build-$${CSS_VERSION}-linux-*.zip" -O css.zip
unzip -q css.zip -d "$config_dir/game/csgo"
rm css.zip

echo "CounterStrikeSharp $${CSS_VERSION} installed"

# Install plugins based on mode
case "${plugin_mode}" in
  "retakes")
    echo "Installing CS2-Retakes plugin..."
    mkdir -p "$config_dir/game/csgo/addons/counterstrikesharp/plugins/CS2Retake"
    cd "$config_dir/game/csgo/addons/counterstrikesharp/plugins/CS2Retake"
    RETAKE_VERSION=$(curl -s https://api.github.com/repos/b3none/cs2-retakes/releases/latest | grep '"tag_name"' | sed -E 's/.*"([^"]+)".*/\1/')
    wget -q "https://github.com/b3none/cs2-retakes/releases/download/$${RETAKE_VERSION}/CS2Retake-$${RETAKE_VERSION}.zip" -O retake.zip
    unzip -q retake.zip
    rm retake.zip
    echo "CS2-Retakes $${RETAKE_VERSION} installed"
    ;;
    
  "practice-plus")
    echo "Installing Practice Mode plugin..."
    mkdir -p "$config_dir/game/csgo/addons/counterstrikesharp/plugins/PracticeMode"
    cd "$config_dir/game/csgo/addons/counterstrikesharp/plugins/PracticeMode"
    wget -q "https://github.com/lengran/cs2-practice-plugin/releases/latest/download/PracticeMode.zip" -O practice.zip
    unzip -q practice.zip
    rm practice.zip
    echo "Practice Mode plugin installed"
    ;;
    
  "deathmatch-custom")
    echo "Installing Deathmatch Core plugin..."
    mkdir -p "$config_dir/game/csgo/addons/counterstrikesharp/plugins/Deathmatch"
    cd "$config_dir/game/csgo/addons/counterstrikesharp/plugins/Deathmatch"
    wget -q "https://github.com/KillStr3aK/cs2-deathmatch/releases/latest/download/Deathmatch-core.zip" -O dm.zip
    unzip -q dm.zip
    rm dm.zip
    echo "Deathmatch Core plugin installed"
    ;;
    
  "executes")
    echo "Executes plugin - community plugin URL needed, skipping for now"
    ;;
    
  "prefire")
    echo "Prefire plugin - community plugin URL needed, skipping for now"
    ;;
    
  *)
    echo "Unknown plugin mode: ${plugin_mode}"
    ;;
esac

cd /
rm -rf /tmp/css-install
echo "Plugin installation complete for mode: ${plugin_mode}"
%{ endif ~}

if [ -n "${gslt}" ]; then
  echo "Starting CS2 server..."
  systemctl enable --now cs2.service
else
  echo "GSLT is empty. Add GSLT to terraform.tfvars and re-apply." > /opt/cs2-server/gslt-missing.txt
fi
